@* Reusable chip-picker for albums, people, or tags.
   Loads items from /api/immich/<type>s and allows add/remove. *@

@inject IHttpClientFactory HttpFactory
@using System.Text.Json

<div class="source-picker">
    <div class="chips">
        @* Filter chips to only show sources matching this picker's SourceType *@
        @foreach (var selected in Selected.Where(s => s.Type == SourceType))
        {
            <span class="chip">
                @selected.Label
                <button @onclick="() => Remove(selected)" aria-label="Remove @selected.Label">×</button>
            </span>
        }
    </div>
    <input type="text" @bind="_search" @bind:event="oninput" @bind:after="FilterItems"
           aria-label="Search @SourceType" placeholder="Search @SourceType..." class="search-input" disabled="@(_loading || _loadError != null)" />
    @if (_loading) { <p class="field-hint" role="status">Loading sources…</p> }
    @if (_loadError != null)
    {
        <p class="field-hint" role="alert">@_loadError <a href="/connection">Configure connection</a>.</p>
        <button type="button" class="btn btn-secondary" @onclick="LoadItemsAsync">Retry loading @SourceType sources</button>
    }
    else if (!_loading && _items.Count == 0) { <p class="field-hint">No @SourceType sources available in Immich.</p> }
    else if (!string.IsNullOrWhiteSpace(_search) && _filtered.Count == 0) { <p class="field-hint" role="status">No matching @SourceType sources.</p> }
    <div class="dropdown" @onmouseleave="() => _showDropdown = false">
        @if (_showDropdown)
        {
            @foreach (var item in _filtered.Take(10))
            {
                <button type="button" class="dropdown-item" @onclick="() => Add(item)">@item.Name</button>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string SourceType { get; set; } = "album";  // "album" | "person" | "tag"
    [Parameter] public List<ImmichLoungeCompanion.Models.ContentSource> Selected { get; set; } = [];
    [Parameter] public EventCallback<List<ImmichLoungeCompanion.Models.ContentSource>> SelectedChanged { get; set; }

    private HttpClient Http => HttpFactory.CreateClient("local");
    private List<SourceItem> _items = [], _filtered = [];
    private string _search = "";
    private bool _showDropdown;
    private bool _loading;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadItemsAsync();

    private async Task LoadItemsAsync()
    {
        var endpoint = SourceType switch
        {
            "album"  => "/api/immich/albums",
            "person" => "/api/immich/people",
            "tag"    => "/api/immich/tags",
            _ => throw new ArgumentException("Invalid source type")
        };
        _loading = true;
        _loadError = null;
        _showDropdown = false;
        try
        {
            _items = await Http.GetFromJsonAsync<List<SourceItem>>(endpoint) ?? [];
            FilterItems();
            _showDropdown = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _items = []; _filtered = [];
            _loadError = "Could not load sources from Immich. Check the server URL and API key, then retry.";
        }
        finally { _loading = false; }
    }

    private void FilterItems()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        _showDropdown = _filtered.Any();
    }

    private async Task Add(SourceItem item)
    {
        if (Selected.Any(s => s.Id == item.Id)) return;
        Selected.Add(new() { Type = SourceType, Id = item.Id, Label = item.Name });
        await SelectedChanged.InvokeAsync(Selected);
        _search = ""; _showDropdown = false;
    }

    private async Task Remove(ImmichLoungeCompanion.Models.ContentSource source)
    {
        Selected.Remove(source);
        await SelectedChanged.InvokeAsync(Selected);
    }

    private record SourceItem(string Id, string Name);
}
