@page "/profiles/{Id}/edit"
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@using System.Text.Json
@using ImmichLoungeCompanion.Models
@using ImmichLoungeCompanion.Immich.Dtos
@inject ImmichLoungeCompanion.Services.IDisplayDateFormattingService DateFormatting

<PageTitle>@(_profile?.Name ?? "Profile") · Immich Lounge</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="@(async context => await ConfirmInternalNavigationAsync(context))" />
@if (_profile == null)
{
    @if (_loadError != null) { <h1>Profile unavailable</h1><p class="error" role="alert">@_loadError</p><a href="/profiles">Back to profiles</a> }
    else { <p role="status">Loading profile…</p> }
}
else
{
    <a class="back-link" href="/profiles">← Profiles</a>
    <div class="page-heading">
        <div><h1>@_profile.Name</h1><p class="page-intro">@SourceSummary · @_profile.Slideshow.IntervalSeconds seconds per photo</p></div>
        <span class="page-badge">Slideshow profile</span>
    </div>
    <nav class="editor-navigation" aria-label="Profile settings">
        @foreach (var view in new[] { "Photos", "Playback", "Appearance" })
        {
            <button type="button" class="@(view == _editorView ? "active" : "")" aria-current="@(view == _editorView ? "page" : null)" @onclick="() => _editorView = view">@view</button>
        }
    </nav>
    <div class="profile-workspace">
    @if (_editorView == "Photos")
    {
        <section class="settings-card editor-card">
            <h2>Choose your photos</h2>
            <p class="section-intro">Combine selections across categories, then narrow them by location.</p>
            <label>Photo source:
                <select value="@(_profile.PhotoSource ?? "")" @onchange="OnPhotoSourceChanged">
                    @if (_profile.PhotoSource == null) { <option value="">Keep current selection</option> }
                    <option value="all">All photos</option>
                    <option value="selected">Selected sources</option>
                    <option value="memories">Memories only</option>
                </select>
            </label>
            <p class="field-hint">All photos uses the whole library. Selected sources uses your albums, people, tags, and smart searches. Location and file filters narrow either choice.</p>
            @if (!_connectionConfigured)
            {
                <div class="connection-notice" role="status"><strong>Connect your Immich library first</strong><p>You can set up playback and appearance while you wait.</p><a class="btn btn-secondary" href="/connection">Set up connection →</a></div>
            }
            <h3 class="criteria-heading">Add criteria</h3>
            <p class="field-hint criteria-hint">Within Selected sources, selections stay active when you switch categories.</p>
            <div class="source-browser-navigation" aria-label="Choose photo sources and location">
                @foreach (var sourceType in new[] { "album", "person", "tag", "search", "location" })
                {
                    var sourceLabel = sourceType == "album" ? "Albums" : sourceType == "person" ? "People" : sourceType == "tag" ? "Tags" : sourceType == "search" ? "Smart search" : "Location";
                    <button type="button" class="@(sourceType == _sourcePickerType ? "active" : "")" aria-pressed="@(sourceType == _sourcePickerType)" disabled="@(sourceType != "location" && (!_canEditContentSources || !_connectionConfigured || _profile.PhotoSource is "all" or "memories"))" @onclick="() => _sourcePickerType = sourceType">@sourceLabel</button>
                }
            </div>
            @if (_sourcePickerType == "location")
            {
                <LocationFilterPicker Value="_locationFilter" OnChanged="CriteriaChanged" />
                <p class="field-hint">Limits all selected sources and memories. Filled fields must all match; leave blank for any location.</p>
            }
            else if (_canEditContentSources && _connectionConfigured && _profile.PhotoSource is not ("all" or "memories"))
            {
                @if (_sourcePickerType == "search")
                {
                    <label>Search terms:
                        <input @bind="_newSearchTerms" @bind:event="oninput" placeholder="For example: beach sunset" />
                    </label>
                    <div class="btn-row"><button type="button" class="btn btn-secondary" @onclick="AddSearchSource" disabled="@string.IsNullOrWhiteSpace(_newSearchTerms)">Add search</button></div>
                    <p class="field-hint">Requires smart search enabled in Immich and assets processed by machine learning. Immich 3.2 and later return up to 1,000 ranked matches per query and library or selected album. Older servers return all result pages.</p>
                }
                else
                {
                @if (_sourcePickerType == "person")
                {
                    <p class="field-hint">For photos shared through an album, select the album too. Choose <strong>Every selection</strong> under Filters to show only photos of the selected person in that album.</p>
                }
                <SourcePicker @key="_sourcePickerType" SourceType="@_sourcePickerType" ShowSelected="false" @bind-Selected="_profile.ContentSources" @bind-Selected:after="CriteriaChanged" />
                }
            }
            else if (!_canEditContentSources)
            {
                <p>This profile uses advanced content rules. Edit those rules through the API; album, people, and tag selections cannot be changed here.</p>
            }
            <section class="criteria-summary" aria-label="Active photo criteria">
                <h3>Showing</h3>
                <p>@CriteriaDescription</p>
                @if (_profile.Memories.Prioritize && (_memoriesEnabled || _profile.Memories.IncludeBirthdays || _profile.Memories.IncludeSaved))
                {
                    <p class="criteria-detail">Matching memories play first.</p>
                }
                @if (_canEditContentSources && _profile.PhotoSource is not ("all" or "memories") && _profile.ContentSources.Any(source => source.Type != "memories"))
                {
                    <div class="selected-sources" aria-label="Selected photo sources">
                        @foreach (var selected in _profile.ContentSources.Where(source => source.Type != "memories"))
                        {
                            <span class="chip">@selected.Label <button type="button" @onclick="() => RemoveSource(selected)" aria-label="Remove @selected.Label">×</button></span>
                        }
                    </div>
                }
                @if (LocationSummary.Length > 0) { <p class="criteria-detail">Limited to: @LocationSummary</p> }
                @if (_profile.DateFilter != null) { <p class="criteria-detail">Date filter: @DateFilterSummary</p> }
                @if (_profile.OnlyPhotosWithPeople) { <p class="criteria-detail">Only photos with people</p> }
                @if (_profile.ExcludedPeople.Count > 0) { <p class="criteria-detail">Excluding: @string.Join(", ", _profile.ExcludedPeople.Select(person => person.Label))</p> }
                @if (_profile.Quality.MinFileSizeKb > 0) { <p class="criteria-detail">Minimum file size: @_profile.Quality.MinFileSizeKb KB</p> }
            </section>
            <details class="advanced-settings"><summary>Memories</summary><div class="advanced-settings-body">
            <label><input type="checkbox" @bind="_profile.Memories.Prioritize" @bind:after="CriteriaChanged" /> Prioritize memories</label>
            <p class="section-intro">Show the memories enabled below first, then the remaining photos without duplicates. Choose a Photo source to refresh memories and start a fresh shuffle each day in the time zone below.</p>
            <label>
                <input type="checkbox" @bind="_memoriesEnabled" @bind:after="CriteriaChanged" /> Include On This Day memories
            </label>
            <label>
                <input type="checkbox" @bind="_profile.Memories.IncludeBirthdays" @bind:after="CriteriaChanged" disabled="@(!_birthdayMemoriesAvailable && !_profile.Memories.IncludeBirthdays)" /> Include birthday memories
            </label>
            @if (!_birthdayMemoriesAvailable)
            {
                <p class="section-intro">Birthday memories require Immich 3.3 or later. They are unavailable until the companion detects a supported server.</p>
            }
            <label>
                <input type="checkbox" @bind="_profile.Memories.IncludeSaved" @bind:after="CriteriaChanged" disabled="@(!_savedMemoriesAvailable && !_profile.Memories.IncludeSaved)" /> Include saved memories
            </label>
            <p class="section-intro">Include past memories saved in Immich. Available with Immich 3.2 or later; future memories are excluded.</p>
            @if (_profile.Memories.IncludeBirthdays)
            {
                <label><input type="checkbox" @bind="_profile.Memories.ShowBirthdayCaptions" /> Show birthday captions</label>
                <p class="section-intro">Set birth dates in Immich. Birthday photos appear from three days before the birthday through the day itself.</p>
            }
            @if (_memoriesEnabled || _profile.Memories.IncludeBirthdays || _profile.Memories.IncludeSaved)
            {
            <label>
                Memories time zone:
                <select @bind="_profile.Memories.TimeZoneId" @bind:after="CriteriaChanged">
                    <option value="">Companion time zone</option>
                    @if (!string.IsNullOrEmpty(_profile.Memories.TimeZoneId) && !_memoryTimeZones.Any(zone => zone.Id == _profile.Memories.TimeZoneId))
                    { <option value="@_profile.Memories.TimeZoneId">@_profile.Memories.TimeZoneId</option> }
                    @foreach (var zone in _memoryTimeZones)
                    { <option value="@zone.Id">@zone.DisplayName (@zone.Id)</option> }
                </select>
            </label>
            }
            </div></details>
            <details class="advanced-settings"><summary>Filters</summary><div class="advanced-settings-body">
                @if (_canEditContentSources)
                {
                <label>
                    Match selected sources:
                    <select @bind="_sourceMatchOperator" @bind:after="CriteriaChanged">
                        <option value="@AssetFilterGroupOperator.Or">Any selection</option>
                        <option value="@AssetFilterGroupOperator.And">Every selection</option>
                    </select>
                </label>
                <p class="section-intro">Any combines selections. Every requires all selections to match.</p>
                }
            <div class="filter-group">
                <h3>Date filter</h3>
                <label>Period:
                    <select value="@(_profile.DateFilter?.Type ?? "none")" @onchange="OnDateFilterModeChanged">
                        <option value="none">All dates</option>
                        <option value="range">Date range</option>
                        <option value="rolling">Rolling window</option>
                    </select>
                </label>
                @if (_profile.DateFilter?.Type == "range")
                {
                    <div class="settings-field-grid">
                        <label>From: <input type="date" value="@DateInputValue(_profile.DateFilter.From)" @onchange="@(e => OnDateBoundChanged(true, e))" /></label>
                        <label>To: <input type="date" value="@DateInputValue(_profile.DateFilter.To)" @onchange="@(e => OnDateBoundChanged(false, e))" /></label>
                    </div>
                    <p class="field-hint">Leave one side empty for an open-ended range. Dates include the entire final UTC day.</p>
                }
                else if (_profile.DateFilter?.Type == "rolling")
                {
                    <div class="settings-field-grid">
                        <label>Last: <input type="number" min="1" max="100" @bind="_profile.DateFilter.Amount" @bind:after="CriteriaChanged" /></label>
                        <label>Unit:
                            <select @bind="_profile.DateFilter.Unit" @bind:after="CriteriaChanged">
                                <option value="days">Days</option><option value="weeks">Weeks</option>
                                <option value="months">Months</option><option value="years">Years</option>
                            </select>
                        </label>
                    </div>
                    <p class="field-hint">Recomputed when the playlist refreshes. Choose 1–100 units.</p>
                }
            </div>
            <label>
                <input id="only-photos-with-people" type="checkbox" @bind="_profile.OnlyPhotosWithPeople" @bind:after="CriteriaChanged" disabled="@(!_peopleFilterAvailable && !_profile.OnlyPhotosWithPeople)" /> Only photos with people
            </label>
            <p class="section-intro">Include photos with any detected face, including unnamed people and memories. Photos with no detected faces are skipped.</p>
            @if (!_peopleFilterAvailable)
            {
                <p class="section-intro">Requires Immich 3.2 or later. Unavailable until the companion detects a supported server. An enabled filter must be turned off to use an older server.</p>
            }
            @if (_connectionConfigured)
            {
                <label>Exclude people (NOT):</label>
                <SourcePicker SourceType="person" @bind-Selected="_profile.ExcludedPeople" @bind-Selected:after="CriteriaChanged" />
            }
            <p class="section-intro">Exclude photos of these people, including memories and selected shared albums.</p>
        <div class="filter-group">
            <h3>File filters</h3>
            <div class="advanced-settings-body">
                <label><input type="checkbox" @bind="_profile.MediaTypes.Photos" @bind:after="CriteriaChanged" /> Include photos</label>

                <label>
                    Minimum file size (KB):
                    <input type="number" value="@GetMinFileSizeKbValue()" @oninput="OnMinFileSizeKbChanged" min="0" step="50" />
                </label>
                <p class="section-intro">Keep 0 to include all file sizes.</p>
            </div>
        </div>
            </div></details>
            @if (_connectionConfigured)
            {
            <div class="btn-row">
                <button type="button" class="btn btn-secondary" @onclick="PreviewMatchCountAsync" disabled="@(_matchCountLoading || !_connectionConfigured)">
                    @if (_matchCountLoading) { <span>Counting…</span> } else { <span>Preview selection</span> }
                </button>
                @if (_matchCount != null && PreviewIsCurrent)
                {
                    <span>@_matchCount.Value matching @(_matchCount.Value == 1 ? "asset" : "assets")</span>
                }
            </div>
            @if (_previewError != null) { <p class="error" role="alert">@_previewError</p> }
            @if (_matchCount != null && PreviewIsCurrent)
            {
                @if (_matchCount == 0) { <p class="field-hint preview-hint">No photos match. Try changing your selections or removing a filter.</p> }
                else if (_previewAssets.Count > 0)
                {
                    <p class="field-hint preview-hint">A sample of matching photos. Previewing does not save your changes.</p>
                    <div class="photo-preview-grid" aria-label="Matching photo samples">
                        @foreach (var asset in _previewAssets)
                        {
                            <figure>
                                @if (asset.ThumbnailUrl == null || _failedPreviewIds.Contains(asset.Id)) { <div class="photo-preview-missing">Thumbnail unavailable</div> }
                                else { <img src="@asset.ThumbnailUrl" alt="Matching photo" loading="lazy" @onerror="() => _failedPreviewIds.Add(asset.Id)" /> }
                                @if (!string.IsNullOrEmpty(asset.SourceLabel)) { <figcaption>@asset.SourceLabel</figcaption> }
                            </figure>
                        }
                    </div>
                }
            }
            }
        </section>
    }
    else if (_editorView == "Playback")
    {
        <section class="settings-card editor-card">
            <h2>Set the pace</h2>
            <p class="section-intro">Choose how long each photo stays on screen and how it moves to the next.</p>
            <div class="settings-field-grid">
                <label>Seconds per photo <input type="number" value="@_profile.Slideshow.IntervalSeconds" @oninput="OnIntervalSecondsChanged" min="3" max="3600" /></label>

            <label>
                Transition:
                <select @bind="_profile.Slideshow.TransitionEffect">
                    <option value="fade">Fade</option>
                    <option value="none">None</option>
                    <option value="slide">Slide</option>
                    <option value="zoom">Zoom</option>
                    <option value="random">Random</option>
                </select>
            </label>
            <label>
                Photo motion
                <select @bind="_profile.Slideshow.PhotoMotion">
                    <option value="none">None</option>
                    <option value="kenBurns">Slow pan and zoom</option>
                </select>
            </label>
            </div>

            <label><input type="checkbox" @bind="_profile.Slideshow.Shuffle" /> Shuffle photos</label>
            @if (!_profile.Slideshow.Shuffle)
            {
                <label>
                    Photo order
                    <select @bind="_profile.Slideshow.DateOrder">
                        <option value="newestFirst">Newest first</option>
                        <option value="oldestFirst">Oldest first</option>
                    </select>
                </label>
                <p class="section-intro">Order photos by their original date.</p>
            }
            <h3>Fit on screen</h3>
            <label><input type="checkbox" @bind="_profile.Display.ZoomToFit" /> Fill the screen with landscape photos</label>
            <p class="section-intro">Fill the screen by cropping the edges of landscape photos. Portrait and square photos still show the whole image.</p>
            <label><input type="checkbox" @bind="_profile.Display.SideBySidePortraits" /> Pair portrait photos side by side</label>
            <p class="section-intro">Pair consecutive portrait photos without cropping. The overlay describes the left photo. Pairs fade together without photo motion.</p>

            <details class="advanced-settings"><summary>More playback options</summary><div class="advanced-settings-body">
                <label>Refresh interval (minutes): <input type="number" value="@_profile.Slideshow.RefreshIntervalMinutes" @oninput="OnRefreshIntervalMinutesChanged" min="5" max="1440" /></label>
            <label>Transition duration (seconds): <input type="number" value="@_profile.Slideshow.TransitionDurationSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnTransitionDurationChanged" min="0.1" max="5" step="0.1" /></label>
            <p class="section-intro">Use 0.1–5 seconds, shorter than the photo interval. Applies to fade, slide, and zoom; None changes photos immediately.</p>
            <label><input type="checkbox" @bind="_profile.Slideshow.PreventScreensaver" /> Prevent System Screensaver from running</label>
            </div></details>
        </section>
    }
    else
    {
        <section class="settings-card editor-card">
            <h2>Make it yours</h2>
            <div>
                <p class="section-intro">Choose the backdrop and the details you want to see on your TV.</p>
                <div class="settings-field-grid">
<label>
                    Image Quality:
                    <select @bind="_profile.ImageQuality">
                        <option value="preview">Preview (recommended)</option>
                        <option value="original">Original</option>
                    </select>
                </label>

                    <label>
                        Overlay Style:
                        <select @bind="_profile.Display.OverlayStyle">
                            <option value="none">None</option>
                            <option value="bottom">Bottom Bar</option>
                            <option value="corner">Corner Pill</option>
                        </select>
                    </label>
                    <label>
                        Background:
                        <select @bind="_profile.Display.BackgroundEffect">
                            <option value="none">None</option>
                            <option value="blur">Blur</option>
                            <option value="ambilight">Ambilight Glow</option>
                        </select>
                    </label>

                </div>
                <p class="section-intro">Use Ambilight Glow for a brighter, room-lighting style backdrop behind the photo.</p>
                <label><input type="checkbox" @bind="_profile.Display.ClockAlwaysVisible" /> Clock Always Visible</label>
                <label><input type="checkbox" @bind="_profile.Display.ShowDate" /> Show Date</label>
                <label><input type="checkbox" @bind="_profile.Display.ShowTimer" /> Show Progress Timer</label>
            </div>
        <details class="settings-card editor-card advanced-settings editor-card-wide">
            <summary>Weather</summary>
            <div class="advanced-settings-body">
                <p class="section-intro">Add a weather overlay by searching for a location or entering coordinates directly.</p>
                <label><input type="checkbox" @bind="_weatherEnabled" @bind:after="OnWeatherToggled" /> Show Weather Overlay</label>
                @if (_weatherEnabled && _profile.Weather != null)
                {
                    <div class="form-group">
                        <label>Location</label>
                        <div class="search-row">
                            <input @bind="_locationQuery" @bind:event="oninput" placeholder="Search city or address…" />
                            <button type="button" @onclick="SearchLocationAsync" class="btn btn-secondary" disabled="@_locationSearching">
                                @if (_locationSearching) { <span>Searching…</span> } else { <span>Search</span> }
                            </button>
                        </div>
                        @if (_locationError != null) { <p class="field-hint" role="status">@_locationError</p> }
                        @if (_locationResults.Count > 0)
                        {
                            <ul class="search-results">
                                @foreach (var r in _locationResults)
                                {
                                    <li><button type="button" @onclick="() => SelectLocation(r)">@r.DisplayName</button></li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="settings-field-grid">
                        <label>Latitude: <input type="number" step="0.0001" value="@_profile.Weather.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeatherLatitudeChanged" /></label>
                        <label>Longitude: <input type="number" step="0.0001" value="@_profile.Weather.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" @oninput="OnWeatherLongitudeChanged" /></label>
                        <label>Poll interval (minutes): <input type="number" value="@_profile.Weather.PollIntervalMinutes" @oninput="OnWeatherPollIntervalMinutesChanged" min="5" max="1440" /></label>
                        <label>
                            Temperature unit:
                            <select @bind="_profile.Display.WeatherUnit">
                                <option value="celsius">Celsius (°C)</option>
                                <option value="fahrenheit">Fahrenheit (°F)</option>
                            </select>
                        </label>
                    </div>
                }
            </div>
        </details>
        <details class="settings-card editor-card advanced-settings">
            <summary>Text and overlays</summary>
            <div class="advanced-settings-body">
                <label>
                    Location format:
                    <select @bind="_profile.Display.LocationFormat">
                        <option value="cityCountry">City, country</option>
                        <option value="cityStateCountry">City, state/province, country</option>
                        <option value="city">City only</option>
                        <option value="stateCountry">State/province, country</option>
                        <option value="country">Country only</option>
                    </select>
                </label>
                <p class="field-hint">Uses the photo's location from Immich. Missing and repeated values are omitted.</p>
                <label>
                        Overlay Behavior:
                        <select @bind="_profile.Display.OverlayBehavior">
                            <option value="always">Always On</option>
                            <option value="fade">Auto-Fade</option>
                            <option value="manual">Manual (OK button)</option>
                        </select>
                    </label>
                <p class="section-intro">Choose whether playback dates and the clock follow the Roku device locale or a custom profile format.</p>
                <label>
                    Formatting Source:
                    <select @bind="_profile.Display.FormatSource">
                        <option value="@ImmichLoungeCompanion.Models.DisplayFormatSource.Roku">Use Roku locale</option>
                        <option value="@ImmichLoungeCompanion.Models.DisplayFormatSource.Profile">Use custom locale and format</option>
                    </select>
                </label>
                @if (_profile.Display.FormatSource == ImmichLoungeCompanion.Models.DisplayFormatSource.Profile)
                {
                    <div class="settings-field-grid">
                        <label>
                            Time Format:
                            <select @bind="_profile.Display.ClockFormat">
                                <option value="HH:mm">24h — 14:05</option>
                                <option value="HH:mm:ss">24h with seconds — 14:05:30</option>
                                <option value="h:mm tt">12h — 2:05 PM</option>
                                <option value="h:mm:ss tt">12h with seconds — 2:05:30 PM</option>
                            </select>
                        </label>
                        <label>
                            Date Format:
                            <select @bind="_profile.Display.DateFormat">
                                @foreach (var option in GetDateFormatOptions(_profile.Display.Locale))
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </label>
                    </div>
                    <label>
                        Date Language:
                        <select @bind="_profile.Display.Locale">
                            <option value="en-US">English (US)</option>
                            <option value="en-GB">English (UK)</option>
                            <option value="nl-NL">Dutch</option>
                            <option value="de-DE">German</option>
                            <option value="fr-FR">French</option>
                            <option value="es-ES">Spanish</option>
                            <option value="it-IT">Italian</option>
                            <option value="pt-BR">Portuguese (Brazil)</option>
                            <option value="pt-PT">Portuguese (Portugal)</option>
                            <option value="sv-SE">Swedish</option>
                            <option value="da-DK">Danish</option>
                            <option value="nb-NO">Norwegian Bokmål</option>
                            <option value="fi-FI">Finnish</option>
                            <option value="pl-PL">Polish</option>
                            <option value="ja-JP">Japanese</option>
                            <option value="zh-CN">Chinese (Simplified)</option>
                        </select>
                    </label>
                }
            </div>
        </details>
        </section>
    }
    </div>
    <div class="editor-footer">
        <div><span class="save-state @(IsDirty ? "pending" : "")" role="status">@(IsDirty ? "Unsaved changes" : "All changes saved")</span>
            @if (_saveError != null) { <p class="error" role="alert">@_saveError</p> }
            @if (_saveMessage != null) { <p class="field-hint" role="status">@_saveMessage</p> }
        </div>
        <div class="btn-row">
            <button @onclick='() => Nav.NavigateTo("/profiles")' class="btn btn-secondary">Close</button>
            <button @onclick="SaveAsync" class="btn btn-primary" disabled="@(!IsDirty || _saving)">@(_saving ? "Saving…" : "Save changes")</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private HttpClient Http => HttpFactory.CreateClient("local");
    private ImmichLoungeCompanion.Models.Profile? _profile;
    private ImmichLoungeCompanion.Models.LocationFilter _locationFilter = new();
    private bool _memoriesEnabled;
    private bool _birthdayMemoriesAvailable;
    private bool _savedMemoriesAvailable;
    private bool _peopleFilterAvailable;
    private List<MemoryTimeZone> _memoryTimeZones = [];
    private bool _canEditContentSources;
    private bool _connectionConfigured;
    private string _editorView = "Photos";
    private string _sourcePickerType = "album";
    private string _newSearchTerms = "";
    private void AddSearchSource()
    {
        var terms = _newSearchTerms.Trim();
        if (_profile == null || terms.Length == 0 || !_canEditContentSources || !_connectionConfigured || _profile?.PhotoSource is "all" or "memories") { return; }
        if (!_profile!.ContentSources.Any(source => source.Type == "search" && string.Equals(source.Id, terms, StringComparison.OrdinalIgnoreCase)))
        { _profile.ContentSources.Add(new() { Type = "search", Id = terms, Label = terms }); }
        _newSearchTerms = "";
        CriteriaChanged();
    }
    private void CriteriaChanged()
    {
        _matchCount = null;
        _previewSnapshot = null;
        _previewAssets.Clear();
        _failedPreviewIds.Clear();
        _previewError = null;
    }
    private static string? DateInputValue(string? value) => value?.Split('T')[0];
    private string DateFilterSummary => _profile?.DateFilter is { Type: "rolling" } rolling
        ? $"Last {rolling.Amount} {rolling.Unit}"
        : $"{_profile?.DateFilter?.From ?? "Any date"} to {_profile?.DateFilter?.To ?? "Any date"}";
    private void OnDateFilterModeChanged(ChangeEventArgs args)
    {
        _profile!.DateFilter = args.Value?.ToString() switch
        {
            "range" => new() { Type = "range" },
            "rolling" => new() { Type = "rolling", Amount = 12, Unit = "months" },
            _ => null
        };
        CriteriaChanged();
    }
    private void OnDateBoundChanged(bool from, ChangeEventArgs args)
    {
        var value = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value!.ToString();
        if (from) { _profile!.DateFilter!.From = value; }
        else { _profile!.DateFilter!.To = value; }
        CriteriaChanged();
    }
    private void OnPhotoSourceChanged(ChangeEventArgs args)
    {
        _profile!.PhotoSource = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value.ToString();
        if (_profile.PhotoSource == "memories" && !_memoriesEnabled && !_profile.Memories.IncludeBirthdays && !_profile.Memories.IncludeSaved)
        {
            _memoriesEnabled = true;
        }
        _sourcePickerType = _profile.PhotoSource == "selected" ? "album" : "location";
        CriteriaChanged();
    }
    private void RemoveSource(ContentSource source)
    {
        _profile!.ContentSources.Remove(source);
        CriteriaChanged();
    }
    private string LocationSummary => string.Join(" · ", new[] { _locationFilter.Country, _locationFilter.State, _locationFilter.City }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string CriteriaDescription
    {
        get
        {
            if (!_profile!.MediaTypes.Photos) { return "Photos are disabled for this profile."; }
            if (_profile.PhotoSource == "all") { return "All photos from the library, narrowed by the filters below."; }
            if (_profile.PhotoSource == "memories") { return "Enabled memories only, narrowed by the filters below."; }
            if (!_canEditContentSources) { return "Photos matching this profile's advanced content rules."; }
            var hasSources = _profile.ContentSources.Any(source => source.Type != "memories");
            var hasMemories = _memoriesEnabled || _profile.Memories.IncludeBirthdays || _profile.Memories.IncludeSaved;
            if (!hasSources) { return _profile.PhotoSource == "selected" ? "Choose at least one album, person, tag, or smart search." : hasMemories ? "Enabled memories only." : "Photos from the whole library."; }
            var description = _sourceMatchOperator == AssetFilterGroupOperator.And
                ? "Photos matching every selected source"
                : "Photos matching any selected source";
            return description + (hasMemories && _profile.PhotoSource == null ? ", plus enabled memories." : ".");
        }
    }
    private string SourceSummary => _profile!.PhotoSource == "all" ? "All photos"
        : _profile.PhotoSource == "memories" ? "Memories only"
        : !_canEditContentSources ? "Advanced content rules"
        : _profile.PhotoSource == "selected" || _profile.ContentSources.Any(source => source.Type != "memories")
            ? $"{_profile.ContentSources.Count(source => source.Type != "memories")} selected sources ({(_sourceMatchOperator == AssetFilterGroupOperator.And ? "all must match" : "any can match")})"
                + (_profile.PhotoSource == null && (_memoriesEnabled || _profile.Memories.IncludeBirthdays || _profile.Memories.IncludeSaved) ? " + memories" : "")
            : _memoriesEnabled || _profile.Memories.IncludeBirthdays || _profile.Memories.IncludeSaved ? "Memories" : "Whole library";
    private AssetFilterGroupOperator _sourceMatchOperator = AssetFilterGroupOperator.Or;
    private AssetFilterGroupOperator _initialSourceMatchOperator;
    private string? _initialContentSourcesSnapshot;
    private bool _weatherEnabled;
    private string _locationQuery = "";
    private List<GeocodeResult> _locationResults = [];
    private bool _locationSearching;
    private int? _matchCount;
    private bool _matchCountLoading;
    private bool _saving;
    private string? _previewSnapshot, _previewError, _loadError, _locationError;
    private List<PreviewAsset> _previewAssets = [];
    private HashSet<string> _failedPreviewIds = [];
    private bool PreviewIsCurrent => _previewSnapshot == BuildPreviewSnapshot();
    private string? _saveError, _saveMessage;
    private string? _initialSnapshot;
    private string? _loadedProfileId;
    private bool _skipNavigationPrompt;

    private record GeocodeResult(string DisplayName, string Lat, string Lon);
    private record ErrorResponse(string Error);
    private record PreviewAsset(string Id, string? ThumbnailUrl, string? SourceLabel);
    private record MatchCountResponse(int MatchedAssets, List<PreviewAsset>? PreviewAssets = null);
    private record DateFormatOption(string Value, string Label);
    private record MemoryTimeZone(string Id, string DisplayName);
    private bool IsDirty => _profile != null && _initialSnapshot != null && BuildSnapshot() != _initialSnapshot;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Id) || string.Equals(_loadedProfileId, Id, StringComparison.Ordinal))
        {
            return;
        }

        try { await LoadProfileAsync(); }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        { _loadError = "This profile does not exist. It may have been deleted."; }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        { _loadError = "Could not load this profile. Reload the page to try again."; }
    }

    private async Task LoadProfileAsync()
    {
        _loadError = null;
        CriteriaChanged();
        _editorView = "Photos";
        _sourcePickerType = "album";
        _newSearchTerms = "";
        _saveError = null;
        _saveMessage = null;
        _locationQuery = "";
        _locationResults = [];
        _locationSearching = false;
        _profile = null;
        _initialSnapshot = null;
        _matchCount = null;
        _matchCountLoading = false;
        var settings = await Http.GetFromJsonAsync<GlobalSettings>("/api/settings");
        _connectionConfigured = !string.IsNullOrWhiteSpace(settings?.Immich.ServerUrl) && !string.IsNullOrWhiteSpace(settings?.Immich.ApiKey);

        var response = await Http.GetFromJsonAsync<ImmichLoungeCompanion.Models.Profile>($"/api/profiles/{Id}");
        _profile = response;
        _sourcePickerType = _profile?.PhotoSource is "all" or "memories" ? "location" : "album";
        _locationFilter = _profile?.LocationFilter ?? new();
        _canEditContentSources = _profile?.CanEditContentSources() ?? true;
        _sourceMatchOperator = _profile?.AssetFilter?.Operator ?? AssetFilterGroupOperator.Or;
        _initialSourceMatchOperator = _sourceMatchOperator;
        if (_profile?.AssetFilter != null && _canEditContentSources)
        {
            // Show the effective selection, including profiles saved with a stale source list.
            _profile.ContentSources = _profile.AssetFilter.Children.Select(rule => new ContentSource
            {
                Type = rule.Type!.Value.ToString().ToLowerInvariant(),
                Id = rule.Id!,
                Label = rule.Label ?? rule.Id!
            }).Concat(_profile.ContentSources.Where(source => source.Type.Equals("memories", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        _initialContentSourcesSnapshot = _profile == null ? null : BuildContentSourcesSnapshot(_profile);
        _memoriesEnabled = _profile?.HasOnThisDaySource() ?? false;
        _birthdayMemoriesAvailable = false;
        _savedMemoriesAvailable = false;
        _peopleFilterAvailable = false;
        _memoryTimeZones = [];
        try
        {
            var capabilities = await Http.GetFromJsonAsync<SearchApiCapabilities>("/api/immich/capabilities");
            _birthdayMemoriesAvailable = capabilities?.BirthdayMemories ?? false;
            _savedMemoriesAvailable = capabilities?.SavedMemories ?? false;
            _peopleFilterAvailable = capabilities?.StructuredSearch ?? false;
            _memoryTimeZones = await Http.GetFromJsonAsync<List<MemoryTimeZone>>("/api/schedule-time-zones") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            // Existing profile settings remain editable if capability detection is unavailable.
        }
        _weatherEnabled = _profile?.Weather?.Enabled ?? false;
        _initialSnapshot = BuildSnapshot();
        _loadedProfileId = Id;
        _skipNavigationPrompt = false;
    }

    private async ValueTask ConfirmInternalNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty || _skipNavigationPrompt)
        {
            return;
        }

        context.PreventNavigation();

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "You have unsaved changes for this profile. Leave without saving?");

        if (!confirmed)
        {
            return;
        }

        _skipNavigationPrompt = true;
        Nav.NavigateTo(context.TargetLocation);
    }

    private async Task SearchLocationAsync()
    {
        if (_locationSearching || string.IsNullOrWhiteSpace(_locationQuery)) return;
        _locationSearching = true;
        _locationError = null;
        _locationResults = [];
        try
        {
            var results = await Http.GetFromJsonAsync<List<GeocodeResult>>(
                $"/api/geocode?q={Uri.EscapeDataString(_locationQuery)}");
            _locationResults = results ?? [];
            if (_locationResults.Count == 0) _locationError = "No places found. Try another name or enter coordinates below.";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _locationError = "Could not search for a location. Try again or enter coordinates below.";
        }
        finally
        {
            _locationSearching = false;
        }
    }

    private void SelectLocation(GeocodeResult r)
    {
        if (_profile?.Weather == null) return;
        _profile.Weather.Latitude = double.Parse(r.Lat, System.Globalization.CultureInfo.InvariantCulture);
        _profile.Weather.Longitude = double.Parse(r.Lon, System.Globalization.CultureInfo.InvariantCulture);
        _locationResults = [];
        _locationQuery = r.DisplayName;
    }

    private void OnWeatherToggled()
    {
        if (_profile == null) return;
        if (_weatherEnabled)
            _profile.Weather ??= new() { Enabled = true, PollIntervalMinutes = 20 };
        else if (_profile.Weather != null)
            _profile.Weather.Enabled = false;
    }

