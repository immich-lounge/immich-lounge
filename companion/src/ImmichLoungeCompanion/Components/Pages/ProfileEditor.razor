    private async Task SaveAsync()
    {
        if (_profile == null || _saving) return;
        var savingProfile = _profile;
        var savingSnapshot = BuildSnapshot();
        _saving = true;
        _saveError = null;
        _saveMessage = null;
        try
        {
            var payload = BuildProfilePayloadForRequest();
            using var response = await Http.PutAsJsonAsync($"/api/profiles/{Id}", payload);
            if (response.IsSuccessStatusCode)
            {
                // A slow save must not overwrite edits made after its request started.
                if (!ReferenceEquals(_profile, savingProfile)) return;
                if (BuildSnapshot() != savingSnapshot)
                {
                    _initialSnapshot = savingSnapshot;
                    _saveMessage = "Saved earlier changes. Save again to keep your latest edits.";
                    return;
                }
                _profile = payload;
                _initialSnapshot = BuildSnapshot();
                _skipNavigationPrompt = true;
                Nav.NavigateTo("/profiles");
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _saveError = err?.Error ?? $"Failed to save profile (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        { _saveError = "Could not save this profile. Your edits are still here; try again."; }
        finally { _saving = false; }
    }

    private async Task PreviewMatchCountAsync()
    {
        if (_profile == null || _matchCountLoading) return;
        var snapshot = BuildPreviewSnapshot();
        _previewError = null;
        _matchCountLoading = true;
        try
        {
            var payload = BuildProfilePayloadForRequest();
            using var response = await Http.PostAsJsonAsync("/api/profiles/preview-count", payload);
            if (snapshot != BuildPreviewSnapshot()) return;
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MatchCountResponse>();
                if (snapshot != BuildPreviewSnapshot()) return;
                _matchCount = result?.MatchedAssets;
                _previewAssets = result?.PreviewAssets ?? [];
                _failedPreviewIds.Clear();
                _previewSnapshot = snapshot;
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _previewError = err?.Error ?? $"Could not preview photos (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            if (snapshot == BuildPreviewSnapshot()) _previewError = "Could not preview matching photos. Check the Immich connection and try again.";
        }
        finally { _matchCountLoading = false; }
    }

    private string BuildPreviewSnapshot()
    {
        if (_profile == null) return "";
        var payload = BuildProfilePayloadForRequest();
        return JsonSerializer.Serialize(new { payload.PhotoSource, payload.AssetFilter, payload.ContentSources, payload.ExcludedPeople, payload.OnlyPhotosWithPeople,
            payload.LocationFilter, payload.DateFilter, payload.Quality, payload.MediaTypes, payload.Memories });
    }

    private string BuildSnapshot()
    {
        if (_profile == null) return "";

        var snapshot = new
        {
            profile = _profile,
            sourceMatchOperator = _sourceMatchOperator,
            locationFilter = _locationFilter,
            memoriesEnabled = _memoriesEnabled,
            weatherEnabled = _weatherEnabled
        };

        return JsonSerializer.Serialize(snapshot);
    }

    private ImmichLoungeCompanion.Models.Profile BuildProfilePayloadForRequest()
    {
        if (_profile == null) throw new InvalidOperationException("Profile is not loaded.");

        var clone = JsonSerializer.Deserialize<ImmichLoungeCompanion.Models.Profile>(
            JsonSerializer.Serialize(_profile)) ?? new();

        clone.LocationFilter = new() { Country = _locationFilter.Country, State = _locationFilter.State, City = _locationFilter.City };
        clone.MediaTypes.Videos = false;
        clone.MediaTypes.LivePhotos = false;
        clone.MediaTypes.VideoAudio = false;

        if (clone.Weather != null) clone.Weather.Enabled = _weatherEnabled;

        clone.ContentSources.RemoveAll(s => s.Type.Equals("memories", StringComparison.OrdinalIgnoreCase));
        if (_memoriesEnabled)
            clone.ContentSources.Add(new() { Type = "memories", Id = "memories", Label = "Memories" });

        if (_canEditContentSources && (BuildContentSourcesSnapshot(clone) != _initialContentSourcesSnapshot ||
            _sourceMatchOperator != _initialSourceMatchOperator))
            clone.AssetFilter = ProfileAssetFilterExtensions.BuildAssetFilterFromContentSources(clone.ContentSources, _sourceMatchOperator);

        return clone;
    }

    private static string BuildContentSourcesSnapshot(Profile profile) =>
        JsonSerializer.Serialize(profile.ContentSources.Where(source =>
            !source.Type.Equals("memories", StringComparison.OrdinalIgnoreCase)));

    private static bool TryParseInt(object? value, out int parsed)
        => int.TryParse(
            Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture),
            System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture,
            out parsed);

    private static bool TryParseDouble(object? value, out double parsed)
    {
        var input = Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture);
        return double.TryParse(
            input,
            System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowThousands,
            System.Globalization.CultureInfo.InvariantCulture,
            out parsed)
            || double.TryParse(
                input,
                System.Globalization.NumberStyles.Float | System.Globalization.NumberStyles.AllowThousands,
                System.Globalization.CultureInfo.CurrentCulture,
                out parsed);
    }

    private IReadOnlyList<DateFormatOption> GetDateFormatOptions(string? locale)
    {
        var previewDate = new DateOnly(2025, 1, 1);

        return
        [
            new("d MMMM yyyy", DateFormatting.FormatDate(previewDate, "d MMMM yyyy", locale)),
            new("MMMM d, yyyy", DateFormatting.FormatDate(previewDate, "MMMM d, yyyy", locale)),
            new("dd/MM/yyyy", DateFormatting.FormatDate(previewDate, "dd/MM/yyyy", locale)),
            new("MM/dd/yyyy", DateFormatting.FormatDate(previewDate, "MM/dd/yyyy", locale)),
            new("yyyy-MM-dd", DateFormatting.FormatDate(previewDate, "yyyy-MM-dd", locale)),
            new("dddd, d MMMM", DateFormatting.FormatDate(previewDate, "dddd, d MMMM", locale))
        ];
    }

    private int GetMinFileSizeKbValue() => _profile?.Quality.MinFileSizeKb ?? 0;
