@page "/connection"
@page "/"
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<PageTitle>Connection · Immich Lounge</PageTitle>
<h1>Connect to Immich</h1>
<p class="page-intro">Connect your Immich library, then create a profile to choose what plays on Roku.</p>

<div class="settings-card">
    <div class="form-group">
        <label for="immich-url">Immich Server URL</label>
        <input id="immich-url" @bind="_serverUrl" @bind:event="oninput" class="form-control" placeholder="http://192.168.1.10:2283" disabled="@_busy" />
    </div>
    <div class="form-group">
        <label for="immich-key">API Key</label>
        <input id="immich-key" @bind="_apiKey" @bind:event="oninput" class="form-control" type="password" disabled="@_busy" />
        <p class="field-hint">In Immich, open your user menu → Account Settings → API Keys and create a dedicated key for Immich Lounge.</p>
        <details class="setup-help">
            <summary>Which API key permissions do I need?</summary>
            <p>For scoped keys, allow <code>asset.read</code>, <code>asset.statistics</code>, <code>asset.view</code>, <code>album.read</code>, <code>person.read</code>, <code>tag.read</code>, and <code>memory.read</code>. Add <code>asset.download</code> for Original image quality.</p>
            <p>If your Immich version does not support scoped keys, use a normal key from the account whose photos you want to show.</p>
        </details>
        <p class="field-hint"><a href="https://immich-lounge.github.io/api-key/" target="_blank" rel="noopener noreferrer">API key setup guide</a> · <a href="https://immich-lounge.github.io/getting-started/" target="_blank" rel="noopener noreferrer">Roku setup guide</a></p>
    </div>

    <div class="btn-row">
        <button @onclick="SaveAsync" class="btn btn-secondary" disabled="@_busy">Save without testing</button>
        <button @onclick="TestConnectionAsync" class="btn btn-primary" disabled="@_busy">@(_testing ? "Saving and testing…" : "Save & Test Connection")</button>
    </div>
    <p class="field-hint">Save &amp; Test Connection saves these settings before checking access to Immich. The settings stay saved even if the test fails.</p>

    @if (_saved)
    {
        <div class="alert alert-success" role="status">Settings saved.</div>
    }

    @if (_errorMessage != null)
    {
        <div class="alert alert-error" role="alert">@_errorMessage</div>
    }

    @if (_testResult != null)
    {
        <div class="alert @(_testResult.Ok ? "alert-success" : "alert-error")" role="status">
            @if (_testResult.Ok)
            {
                <span>Connected — @_testResult.ImageCount images, @_testResult.VideoCount videos</span>
                <p><a href="/profiles">Next: create or choose a profile</a></p>
                @if (_testResult.SearchApi is { } search)
                {
                    <p>Immich @(search.ServerVersion ?? "version unknown") · @(search.StructuredSearch ? "Search API v2" : "Legacy search")</p>
                    @if (search.Warning != null) { <p>@search.Warning</p> }
                }
            }
            else
            {
                <span>Failed: @_testResult.Error</span>
            }
        </div>
    }
</div>

@code {
    private HttpClient Http => HttpFactory.CreateClient("local");
    private string _friendlyName = "";
    private string _serverUrl = "";
    private string _apiKey = "";
    private bool _saved;
    private bool _busy, _testing;
    private string? _errorMessage;
    private TestResult? _testResult;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Http.GetFromJsonAsync<ImmichLoungeCompanion.Models.GlobalSettings>("/api/settings");
        if (settings != null)
        {
            _friendlyName = settings.FriendlyName;
            _serverUrl = settings.Immich.ServerUrl;
            _apiKey = settings.Immich.ApiKey;
        }
    }

    private async Task SaveAsync()
    {
        if (_busy) return;
        _busy = true;
        try { await SaveAsyncInternal(showSavedBanner: true); }
        catch (HttpRequestException) { _errorMessage = "Could not reach the companion. Try again."; }
        finally { _busy = false; }
    }

    private async Task<bool> SaveAsyncInternal(bool showSavedBanner)
    {
        _saved = false;
        _errorMessage = null;
        _testResult = null;

        var response = await Http.PutAsJsonAsync("/api/settings", new
        {
            friendlyName = _friendlyName,
            immich = new { serverUrl = _serverUrl, apiKey = _apiKey }
        });

        if (response.IsSuccessStatusCode)
        {
            _saved = showSavedBanner;
            _testResult = null;
            return true;
        }

        var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
        _errorMessage = err?.Error ?? "Failed to save settings.";
        return false;
    }

    private async Task TestConnectionAsync()
    {
        if (_busy) return;
        _busy = true; _testing = true;
        try
        {
            if (!await SaveAsyncInternal(showSavedBanner: true)) return;
            _testResult = await Http.GetFromJsonAsync<TestResult>("/api/immich/test");
        }
        catch (HttpRequestException) { _errorMessage = _saved ? "Settings saved, but the connection test could not finish. Try again." : "Could not save settings. Try again."; }
        finally { _busy = false; _testing = false; }
    }

    private record ErrorResponse(string Error);
    private record TestResult(bool Ok, int ImageCount, int VideoCount, string? Error,
        ImmichLoungeCompanion.Immich.Dtos.SearchApiCapabilities? SearchApi);
}
