namespace tests
  @suite("OverlayComponent Helpers")
  class OverlayComponentTests extends rooibos.BaseTestSuite

    @describe("Location format")

    @it("Malformed EXIF cannot crash date fallback before drawing descriptions")
    function test_descriptionDateFallback()
      for each exif in [invalid, "bad", 3, {}, { dateTimeOriginal: 3 }]
        meta = { exifInfo: exif, fileCreatedAt: "2025-07-14T12:00:00Z" }
        m.assertEqual(FormatAssetDateForDisplay(meta, "MMMM d, yyyy", "en-US"), "July 14, 2025")
      end for
      m.assertEqual(FormatAssetDateForDisplay({ exifInfo: {}, fileCreatedAt: 3 }, "MMMM d, yyyy", "en-US"), "")
    end function

    @it("The None overlay style hides descriptions even when selected")
    function test_descriptionNone()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      overlay.overlayStyle = "none"
      overlay.overlayFields = ["description"]
      overlay.assetMeta = { exifInfo: { description: "A mountain walk" } }
      m.assertFalse(overlay.findNode("descriptionLine").visible)
      m.assertFalse(overlay.findNode("cornerDescription").visible)
    end function

    @it("Descriptions are opt-in, wrap within each photo, and clear for missing metadata")
    function test_descriptions()
      for each style in ["bottom", "corner"]
        overlay = CreateObject("roSGNode", "OverlayComponent")
        overlay.overlayStyle = style
        overlay.overlayBehavior = "always"
        overlay.viewportWidth = 960
        overlay.textAlignment = "right"
        overlay.assetMeta = { exifInfo: { description: "A mountain walk" } }
        labelId = "descriptionLine"
        if style = "corner" then labelId = "cornerDescription"
        label = overlay.findNode(labelId)
        m.assertFalse(label.visible)
        overlay.overlayFields = ["description"]
        overlay.assetMeta = { exifInfo: { description: "  A mountain walk" + Chr(10) + "in summer  " } }
        m.assertEqual(label.text, "A mountain walk in summer")
        m.assertTrue(label.visible)
        m.assertEqual(label.maxLines, 2)
        m.assertEqual(label.height, 0.0)
        m.assertEqual(label.horizAlign, "right")
        if style = "bottom" then m.assertEqual(label.width, 840.0)
        overlay.visible = false
        m.assertFalse(label.visible)
        overlay.visible = true
        m.assertTrue(label.visible)
        for each meta in [{}, { exifInfo: invalid }, { exifInfo: "bad" }, { exifInfo: { description: 3 } }, { exifInfo: { description: " " } }]
          overlay.assetMeta = meta
          m.assertEqual(label.text, "")
          m.assertFalse(label.visible)
        end for
      end for
    end function

    @it("Late descriptions respect externally hidden portrait overlays")
    function test_descriptionLateMetadata()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      overlay.externallyManaged = true
      overlay.overlayStyle = "bottom"
      overlay.overlayFields = ["description"]
      overlay.overlayBehavior = "always"
      overlay.visible = false
      overlay.assetMeta = { exifInfo: { description: "A mountain walk" } }
      m.assertFalse(overlay.visible)
      m.assertFalse(overlay.findNode("descriptionLine").visible)
    end function

    @it("Caption brightness changes paired text without dimming its background or single photos")
    function test_pairedBrightness()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      originalColor = overlay.findNode("dateLine").color
      overlay.viewportWidth = 960
      overlay.pairedTextBrightness = 100
      brightColor = overlay.findNode("dateLine").color
      backdropOpacity = overlay.findNode("bottomBackdrop").opacity
      overlay.pairedTextBrightness = 50
      m.assertNotEqual(overlay.findNode("dateLine").color, brightColor)
      m.assertEqual(overlay.findNode("bottomBackdrop").opacity, backdropOpacity)
      overlay.viewportWidth = 1920
      m.assertEqual(overlay.findNode("dateLine").color, originalColor)
    end function

    @it("Paired contrast backgrounds follow content and visibility without changing single photos")
    function test_pairedContrast()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      overlay.viewportWidth = 960
      overlay.overlayStyle = "bottom"
      overlay.overlayFields = ["location"]
      overlay.assetMeta = { exifInfo: { city: "Paris" } }
      m.assertTrue(overlay.findNode("bottomBackdrop").visible)
      overlay.visible = false
      m.assertFalse(overlay.findNode("bottomBackdrop").visible)
      overlay.visible = true
      overlay.assetMeta = {}
      m.assertFalse(overlay.findNode("bottomBackdrop").visible)
      overlay.assetMeta = { exifInfo: { city: "Paris" } }
      overlay.viewportWidth = 1920
      m.assertFalse(overlay.findNode("bottomBackdrop").visible)
      m.assertEqual(overlay.findNode("locationLine").horizAlign, "left")
    end function

    @it("Right captions align to the outer edge and corner captions avoid the shared clock")
    function test_pairedAlignment()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      overlay.viewportWidth = 960
      overlay.textAlignment = "right"
      m.assertEqual(overlay.findNode("dateLine").horizAlign, "right")
      m.assertEqual(overlay.findNode("albumLine").horizAlign, "right")
      m.assertEqual(overlay.findNode("cornerDate").translation, [504.0, 198.0])
      overlay.textAlignment = "left"
      m.assertEqual(overlay.findNode("dateLine").horizAlign, "left")
      m.assertEqual(overlay.findNode("cornerDate").translation, [60.0, 54.0])
      overlay.viewportWidth = 1920
      m.assertEqual(overlay.findNode("cornerLocation").translation, [55.0, 90.0])
    end function

    @it("Paired widths contain long labels and restore the original single layout")
    function test_pairedWidths()
      overlay = CreateObject("roSGNode", "OverlayComponent")
      overlay.viewportWidth = 960
      m.assertEqual(overlay.findNode("dateLine").width, 840.0)
      m.assertEqual(overlay.findNode("peopleLine").width, 840.0)
      m.assertEqual(overlay.findNode("albumLine").width, 840.0)
      overlay.viewportWidth = 1920
      m.assertEqual(overlay.findNode("dateLine").width, 1800.0)
      m.assertEqual(overlay.findNode("albumLine").width, 900.0)
    end function

    @it("Late metadata cannot reveal an externally hidden paired overlay")
    function test_pairedLateMetadata()
      for each style in ["bottom", "corner"]
        overlay = CreateObject("roSGNode", "OverlayComponent")
        overlay.externallyManaged = true
        overlay.overlayStyle = style
        overlay.overlayFields = ["location"]
        overlay.overlayBehavior = "always"
        overlay.visible = false
        overlay.assetMeta = { exifInfo: { city: "Zurich", country: "Switzerland" } }
        m.assertFalse(overlay.visible)
        labelId = "locationLine"
        if style = "corner" then labelId = "cornerLocation"
        m.assertFalse(overlay.findNode(labelId).visible)
        overlay.visible = true
        m.assertEqual(overlay.findNode(labelId).text, "Zurich, Switzerland")
        m.assertTrue(overlay.findNode(labelId).visible)
      end for
    end function

    @it("Supports all five formats with the original default")
    function test_locationFormats()
      meta = { exifInfo: { city: "Springfield", state: "Illinois", country: "USA" } }
      m.assertEqual(FormatAssetLocation(meta, "cityCountry"), "Springfield, USA")
      m.assertEqual(FormatAssetLocation(meta, "cityStateCountry"), "Springfield, Illinois, USA")
      m.assertEqual(FormatAssetLocation(meta, "city"), "Springfield")
      m.assertEqual(FormatAssetLocation(meta, "stateCountry"), "Illinois, USA")
      m.assertEqual(FormatAssetLocation(meta, "country"), "USA")
      for each format in [invalid, "unknown", {}, 3]
        m.assertEqual(FormatAssetLocation(meta, format), "Springfield, USA")
      end for
    end function

    @it("Skips missing and blank fields and repeated place names")
    function test_locationMissingAndRepeated()
      m.assertEqual(FormatAssetLocation({ exifInfo: { city: " Zürich ", state: "zürich", country: " Switzerland " } }, "cityStateCountry"), "Zürich, Switzerland")
      m.assertEqual(FormatAssetLocation({ exifInfo: { city: " ", state: "Illinois", country: "" } }, "cityStateCountry"), "Illinois")
      m.assertEqual(FormatAssetLocation({ exifInfo: { country: "USA" } }, "city"), "")
      m.assertEqual(FormatAssetLocation({ exifInfo: { country: "USA" } }, "cityCountry"), "USA")
      for each meta in [invalid, {}, { exifInfo: invalid }, { exifInfo: "bad" }, { exifInfo: { city: 3, country: [] } }]
        m.assertEqual(FormatAssetLocation(meta, "cityCountry"), "")
      end for
    end function

    @it("Updating the format redraws current labels in both overlay styles")
    function test_locationFormatRefresh()
      for each style in ["bottom", "corner"]
        overlay = CreateObject("roSGNode", "OverlayComponent")
        overlay.overlayStyle = style
        overlay.overlayFields = ["location"]
        overlay.overlayBehavior = "always"
        overlay.assetMeta = { exifInfo: { city: "Springfield", state: "Illinois", country: "USA" } }
        labelId = "locationLine"
        if style = "corner" then labelId = "cornerLocation"
        label = overlay.findNode(labelId)
        m.assertEqual(label.text, "Springfield, USA")
        overlay.locationFormat = "cityStateCountry"
        m.assertEqual(label.text, "Springfield, Illinois, USA")
        m.assertTrue(label.visible)
        overlay.locationFormat = "country"
        m.assertEqual(label.text, "USA")
        overlay.assetMeta = { exifInfo: { city: "Springfield" } }
        m.assertEqual(label.text, "")
        m.assertFalse(label.visible)
      end for
    end function

    @describe("Birthday captions")

    @it("Shows a caption in both overlay styles even without an asset date")
    function test_birthdayCaption()
      for each style in ["bottom", "corner"]
        overlay = CreateObject("roSGNode", "OverlayComponent")
        overlay.overlayStyle = style
        overlay.overlayFields = []
        overlay.overlayBehavior = "always"
        overlay.birthdayCaption = "Emma's birthday"
        if style = "bottom" then
          label = overlay.findNode("dateLine")
        else
          label = overlay.findNode("cornerDate")
        end if
        m.assertEqual(label.text, "Emma's birthday")
        m.assertTrue(label.visible)
        overlay.birthdayCaption = ""
        m.assertEqual(label.text, "")
        m.assertFalse(label.visible)
      end for
    end function

    @describe("FormatAssetDate")

    @it("Uses dateTimeOriginal when present")
    function test_formatDate()
      asset = { exifInfo: { dateTimeOriginal: "2024-06-15T10:30:00.000Z" } }
      m.assertEqual(FormatAssetDateForDisplay(asset, "MMMM d, yyyy", "en-US"), "June 15, 2024")
    end function

    @it("Falls back to fileCreatedAt when exif date is absent")
    function test_dateFallback()
      asset = { exifInfo: {}, fileCreatedAt: "2023-01-05T08:00:00.000Z" }
      m.assertEqual(FormatAssetDateForDisplay(asset, "MMMM d, yyyy", "en-US"), "January 5, 2023")
    end function

    @it("Formats German dates with a trailing day period")
    function test_germanDatePunctuation()
      parsed = {
        year: 2026
        month: 3
        day: 22
        weekday: 0
      }
      m.assertEqual(FormatLocalizedDate(parsed, "d MMMM yyyy", "de-DE"), "22. März 2026")
    end function

    @it("Formats Polish dates with localized month forms")
    function test_polishDateLocalization()
      parsed = {
        year: 2026
        month: 3
        day: 24
        weekday: 2
      }
      m.assertEqual(FormatLocalizedDate(parsed, "d MMMM yyyy", "pl-PL"), "24 marca 2026")
    end function

    @describe("BuildPeopleString")

    @it("Joins people names with comma separator")
    function test_people()
      asset = { people: [{ name: "Alice" }, { name: "Bob" }] }
      m.assertEqual(BuildPeopleString(asset), "Alice, Bob")
    end function

  end class
end namespace
