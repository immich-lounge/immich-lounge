namespace tests
  @suite("CompanionApiTask Helpers")
  class CompanionApiTaskTests extends rooibos.BaseTestSuite

    @describe("TruncatePlaylistForRegistry")

    @it("Caps playlist at 50 entries")
    function test_truncate()
      entries = []
      for i = 1 to 150
        entries.Push({ id: "id" + Str(i).Trim(), type: "photo" })
      end for
      truncated = TruncatePlaylistForRegistry(entries)
      m.assertEqual(truncated.Count(), 50)
    end function

    @describe("PrepareEntryForRegistry")

    @it("Omits birthday captions from short and long offline playlists")
    function test_noCachedBirthdayCaptions()
      for each count in [1, 60]
        entries = []
        for i = 1 to count
          entries.Push({ id: "photo" + Str(i).Trim(), type: "photo", birthdayCaption: "Emma's birthday" })
        end for
        cached = TruncatePlaylistForRegistry(entries)
        m.assertInvalid(cached[0].birthdayCaption)
        m.assertEqual(entries[0].birthdayCaption, "Emma's birthday")
      end for
    end function

    @it("Truncates sourceLabel to 20 characters")
    function test_truncateLabel()
      entry = { id: "abc", type: "photo", sourceLabel: "This Label Is Way Too Long For Registry" }
      result = PrepareEntryForRegistry(entry)
      m.assertTrue(Len(result.sourceLabel) <= 20)
    end function

    @describe("BuildPlaylistUrl")

    @it("Builds URL with profile ID and count")
    function test_url()
      url = BuildPlaylistUrl("http://192.168.1.10:4383", "living-room", 500, 100)
      m.assertEqual(url, "http://192.168.1.10:4383/api/profiles/living-room/playlist?count=500&offset=100")
    end function

    @it("Adds playlistVersion when present")
    function test_urlWithPlaylistVersion()
      url = BuildPlaylistUrlWithVersion("http://192.168.1.10:4383", "living-room", 500, 100, "v1")
      m.assertEqual(url, "http://192.168.1.10:4383/api/profiles/living-room/playlist?count=500&offset=100&playlistVersion=v1")
    end function

  end class
end namespace
