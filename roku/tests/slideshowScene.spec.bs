namespace tests
  @suite("SlideshowScene Helpers")
  class SlideshowSceneTests extends rooibos.BaseTestSuite

    @describe("Portrait pairs")

    @it("Pairs only a portrait with an adjacent photo without wrapping")
    function test_portraitPairCandidate()
      playlist = [{ id: "a", type: "photo" }, { id: "b", type: "photo" }, { id: "v", type: "video" }]
      m.assertEqual(PortraitPairCandidateIndex(playlist, 0, 810, 1080, true), 1)
      m.assertEqual(PortraitPairCandidateIndex(playlist, 0, 810, 1080, false), -1)
      m.assertEqual(PortraitPairCandidateIndex(playlist, 0, 1920, 1080, true), -1)
      m.assertEqual(PortraitPairCandidateIndex(playlist, 0, 1080, 1080, true), -1)
      m.assertEqual(PortraitPairCandidateIndex(playlist, 1, 810, 1080, true), -1)
      m.assertEqual(PortraitPairCandidateIndex(playlist, 2, 810, 1080, true), -1)
      m.assertEqual(PortraitPairCandidateIndex([], 0, 810, 1080, true), -1)
    end function

    @it("A pair shows both photos in full in separate screen halves")
    function test_portraitPairLayout()
      layout = PortraitPairLayout(3000, 4000, 2000, 3000)
      m.assertEqual(layout.left.width, 810)
      m.assertEqual(layout.left.height, 1080)
      m.assertEqual(layout.left.x, 75)
      m.assertEqual(layout.right.width, 720)
      m.assertEqual(layout.right.x, 1080)
      m.assertInvalid(PortraitPairLayout(3000, 4000, 4000, 3000))
      m.assertInvalid(PortraitPairLayout(3000, 4000, 3000, 3000))
      m.assertInvalid(PortraitPairLayout(3000, 4000, 0, 0))
    end function

    @it("Portrait pair layouts stay inside their cells on the 3-pixel grid")
    function test_portraitPairGrid()
      for each dimensions in [[3019, 4031], [1001, 6017], [2999, 3000]]
        layout = PortraitPairLayout(dimensions[0], dimensions[1], dimensions[0], dimensions[1])
        for each cell in [layout.left, layout.right]
          m.assertEqual(cell.width mod 3, 0)
          m.assertEqual(cell.height mod 3, 0)
          m.assertEqual(cell.x mod 3, 0)
          m.assertEqual(cell.y mod 3, 0)
          m.assertTrue(cell.width <= 960)
          m.assertTrue(cell.height <= 1080)
        end for
        m.assertTrue(layout.left.x + layout.left.width <= 960)
        m.assertTrue(layout.right.x >= 960)
        m.assertTrue(layout.right.x + layout.right.width <= 1920)
      end for
    end function

    @it("Navigation skips a displayed partner and returns to known pairs")
    function test_portraitPairNavigation()
      playlist = [{ id: "a" }, { id: "b" }, { id: "c" }, { id: "d" }]
      pairs = { a: "b", c: "d" }
      m.assertEqual(NextPortraitSlideIndex(0, 4, 2), 2)
      m.assertEqual(NextPortraitSlideIndex(2, 4, 2), 0)
      m.assertEqual(NextPortraitSlideIndex(0, 4, 1), 1)
      m.assertEqual(PreviousPortraitSlideIndex(playlist, 2, pairs, true), 0)
      m.assertEqual(PreviousPortraitSlideIndex(playlist, 0, pairs, true), 2)
      m.assertEqual(PreviousPortraitSlideIndex(playlist, 2, pairs, false), 1)
      m.assertEqual(PreviousPortraitSlideIndex(playlist, 2, {}, true), 1)
    end function

    @it("A refreshed playlist skips only the partner that is still adjacent")
    function test_portraitPairRefresh()
      playlist = [{ id: "a" }, { id: "b" }, { id: "c" }]
      m.assertEqual(PortraitSlideAdvanceCount(playlist, 0, "b"), 2)
      m.assertEqual(PortraitSlideAdvanceCount(playlist, 0, "c"), 1)
      m.assertEqual(PortraitSlideAdvanceCount(playlist, 0, ""), 1)
      m.assertEqual(PortraitSlideAdvanceCount(playlist, 2, "a"), 1)
      m.assertEqual(PreviousPortraitSlideIndex(playlist, 2, { a: "c" }, true), 1)
    end function

    @describe("Photo layout")

    @it("Existing profiles show the whole landscape photo")
    function test_fitLayoutDefault()
      node = { bitmapWidth: 4000, bitmapHeight: 3000 }
      m.assertTrue(ApplyMainPosterLayoutForScene({ sceneWidth: 1920, sceneHeight: 1080 }, node))
      m.assertEqual(node.width, 1440)
      m.assertEqual(node.height, 1080)
      m.assertEqual(node.translation, [240, 0])
    end function

    @it("Zoom to fit covers the screen and centers a landscape photo")
    function test_zoomToFitLandscape()
      node = { bitmapWidth: 4000, bitmapHeight: 3000 }
      m.assertTrue(ApplyMainPosterLayoutForScene({ sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }, node))
      m.assertEqual(node.width, 1920)
      m.assertEqual(node.height, 1440)
      m.assertEqual(node.translation, [0, -180])
      m.assertEqual(node.scale, [1.0, 1.0])
    end function

    @it("Wide photos fill the height and crop the sides")
    function test_zoomToFitWideLandscape()
      node = { bitmapWidth: 4000, bitmapHeight: 1500 }
      m.assertTrue(ApplyMainPosterLayoutForScene({ sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }, node))
      m.assertEqual(node.width, 2880)
      m.assertEqual(node.height, 1080)
      m.assertEqual(node.translation, [-480, 0])
    end function

    @it("Portrait and square photos still show the whole image")
    function test_zoomToFitPortraitAndSquare()
      ctx = { sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }
      portrait = { bitmapWidth: 3000, bitmapHeight: 4000 }
      m.assertTrue(ApplyMainPosterLayoutForScene(ctx, portrait))
      m.assertEqual(portrait.width, 810)
      m.assertEqual(portrait.height, 1080)
      m.assertEqual(portrait.translation, [555, 0])
      square = { bitmapWidth: 3000, bitmapHeight: 3000 }
      m.assertTrue(ApplyMainPosterLayoutForScene(ctx, square))
      m.assertEqual(square.width, 1080)
      m.assertEqual(square.translation, [420, 0])
    end function

    @it("Disabling zoom to fit resets the same reused poster")
    function test_zoomToFitDisable()
      ctx = { sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }
      node = { bitmapWidth: 4000, bitmapHeight: 3000 }
      m.assertTrue(ApplyMainPosterLayoutForScene(ctx, node))
      ctx.zoomToFit = false
      m.assertTrue(ApplyMainPosterLayoutForScene(ctx, node))
      m.assertEqual(node.width, 1440)
      m.assertEqual(node.translation, [240, 0])
    end function

    @it("Fill layouts cover all edges and stay on the 3-pixel grid")
    function test_zoomToFitGrid()
      ctx = { sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }
      for each dimensions in [[4031, 3019], [6017, 1001], [1920, 1080]]
        node = { bitmapWidth: dimensions[0], bitmapHeight: dimensions[1] }
        m.assertTrue(ApplyMainPosterLayoutForScene(ctx, node))
        m.assertEqual(node.width mod 3, 0)
        m.assertEqual(node.height mod 3, 0)
        m.assertEqual(node.translation[0] mod 3, 0)
        m.assertEqual(node.translation[1] mod 3, 0)
        m.assertTrue(node.translation[0] <= 0)
        m.assertTrue(node.translation[1] <= 0)
        m.assertTrue(node.translation[0] + node.width >= 1920)
        m.assertTrue(node.translation[1] + node.height >= 1080)
      end for
    end function

    @it("Ken Burns motion stays inside the crop at both endpoints")
    function test_zoomToFitMotionCoverage()
      ctx = { sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }
      node = { width: 1920, height: 1440 }
      plan = {
        startScale: 1.0, endScale: 1.06
        startTranslation: [18, -9999], endTranslation: [-9999, 9999]
      }
      ConstrainPhotoMotionPlanForScene(ctx, node, plan)
      m.assertEqual(plan.startTranslation, [0.0, -360.0])
      for each stage in ["start", "end"]
        scale = plan[stage + "Scale"]
        translation = plan[stage + "Translation"]
        m.assertTrue(translation[0] + 960 * (1 - scale) <= 0)
        m.assertTrue(translation[1] + 720 * (1 - scale) <= 0)
        m.assertTrue(translation[0] + 960 + 960 * scale >= 1920)
        m.assertTrue(translation[1] + 720 + 720 * scale >= 1080)
      end for
    end function

    @it("Normal photo motion is unchanged when zoom to fit is off")
    function test_fitMotionUnchanged()
      plan = { startScale: 1.0, endScale: 1.06, startTranslation: [18, 9], endTranslation: [-9, -18] }
      ConstrainPhotoMotionPlanForScene({ zoomToFit: false }, { width: 1920, height: 1440 }, plan)
      m.assertEqual(plan.startTranslation, [18, 9])
      m.assertEqual(plan.endTranslation, [-9, -18])
    end function

    @it("Profile refresh leaves motion on the current fitted photo alone")
    function test_zoomToFitEnabledDuringTransition()
      ctx = { sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }
      node = { width: 1440, height: 1080 }
      plan = { startScale: 1.0, endScale: 1.06, startTranslation: [240, 0], endTranslation: [246, 3] }
      ConstrainPhotoMotionPlanForScene(ctx, node, plan)
      m.assertEqual(plan.startTranslation, [240, 0])
      m.assertEqual(plan.endTranslation, [246, 3])
    end function

    @it("Unknown bitmap dimensions wait for layout retry")
    function test_layoutNotReady()
      node = { bitmapWidth: 0, bitmapHeight: 0, width: 1920, height: 1080 }
      m.assertFalse(ApplyMainPosterLayoutForScene({ sceneWidth: 1920, sceneHeight: 1080, zoomToFit: true }, node))
      m.assertEqual(node.width, 1920)
    end function

    @describe("HistoryBuffer")

    @it("Pop returns most recently pushed entry")
    function test_historyPushPop()
      hist = []
      HistoryPush(hist, { id: "a", type: "photo" })
      HistoryPush(hist, { id: "b", type: "photo" })
      entry = HistoryPop(hist)
      m.assertEqual(entry.id, "b")
    end function

    @it("Buffer is capped at 20 entries")
    function test_historyMax()
      hist = []
      for i = 1 to 25
        HistoryPush(hist, { id: "id" + Str(i).Trim(), type: "photo" })
      end for
      m.assertTrue(hist.Count() <= 20)
    end function

    @describe("ResetFailureCounter")

    @it("Always returns zero")
    function test_failureReset()
      m.assertEqual(ResetFailureCounter(21), 0)
    end function

    @describe("GetDisplayInterval")

    @it("Video returns 0 to play to completion")
    function test_intervalVideo()
      m.assertEqual(GetDisplayInterval({ type: "video" }, 10), 0)
    end function

    @it("Photo returns the configured interval")
    function test_intervalPhoto()
      m.assertEqual(GetDisplayInterval({ type: "photo" }, 10), 10)
    end function

  end class
end namespace
